{
  "permissions": {
    "allow": [
      "Read:**/*",
      "Edit:**/*.py",
      "Edit:**/*.md",
      "Write:**/*.py",
      "Write:**/*.md",
      "Glob:**",
      "Grep:**",
      "Bash:git status",
      "Bash:git diff*",
      "Bash:git log*",
      "Bash:git add*",
      "Bash:git commit*",
      "Bash:git checkout*",
      "Bash:git pull*",
      "Bash:git fetch*",
      "Bash:git push origin*",
      "Bash:git branch*",
      "Bash:python*",
      "Bash:ssh janken@192.168.1.142*"
    ],
    "deny": [
      "Write:**/.env*",
      "Write:**/.git/**",
      "Write:**/__pycache__/**",
      "Bash:rm -rf*",
      "Bash:git push --force*",
      "Bash:git push -f*",
      "Bash:git reset --hard*"
    ]
  },
  "env": {
    "PYTHONUNBUFFERED": "1"
  },
  "cleanupPeriodDays": 30
}
